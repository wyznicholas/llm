<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.nicholas.om-kudos</string>
  <key>ProgramArguments</key><array><string>/Users/nicholas/.local/bin/om-kudos</string></array>
  <!-- Daily: the launch check runs every day; run.ts itself only does the
       weekly pick on Mon/Wed/Fri. 10:15 sits after the 08:47 workflow review. -->
  <key>StartCalendarInterval</key><dict><key>Hour</key><integer>10</integer><key>Minute</key><integer>15</integer></dict>
  <!-- Without a ProcessType, launchd throttles the job's CPU and I/O as
       background work: measured 2026-10-12, the GitLab read took 4.5 min
       under launchd against 1.3 min from a shell. -->
  <key>ProcessType</key><string>Standard</string>
  <key>StandardOutPath</key><string>/Users/nicholas/.local/state/kudos/logs/launchd.out</string>
  <key>StandardErrorPath</key><string>/Users/nicholas/.local/state/kudos/logs/launchd.err</string>
</dict>
</plist>
