#!/bin/bash
# Mobile Scout fixture gate. Runs under launchd before phase 1; non-zero aborts
# the night and midnight-run.sh pages chat.
#
# What it guarantees to the phases, or the night does not start:
#   1. the iOS simulator is booted and OpenFloor is installed on it,
#   2. the scout's OWN checkout is at origin/main with deps installed,
#   3. the scout's OWN Metro is serving that checkout on :8090, and the dev
#      client has actually bundled from it,
#   4. Maestro can read the app's UI tree.
# It records what the night drives in $ROUTINE_WORK/build-stamp.txt, because a
# finding that cannot name its build cannot be reproduced.
#
# Why its own checkout and port: the shared checkout under ~/Documents is
# unreadable to bash under launchd (TCC), and :8081 belongs to whichever
# om-task owner is using the Android emulator. A dev client re-pointed at their
# Metro would audit THEIR branch and never say so (see openfloor-mobile-env.md,
# "concurrent owners measure each other's code").
set -uo pipefail
export PATH="/opt/homebrew/opt/node@22/bin:$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin"
export JAVA_HOME=/opt/homebrew/opt/openjdk@17

UDID="${MOBILE_SCOUT_UDID:-2BAC3CD5-E76D-4E80-9EF0-DE143250D240}"   # iPhone 17 Pro, iOS 26.5
BUNDLE_ID=sh.openmarket.openfloor
APP_DIR="$HOME/.local/share/mobile-scout/openmarket-chat-app"
NPMRC=/Users/nicholas/Documents/GitlabRepos/openmarket-chat/.npmrc  # read by pnpm (node holds the TCC grant), never by bash
PORT=8090
STATE="$HOME/.local/state/routines/mobile-scout"
PIDFILE="$STATE/metro.pid"
METRO_LOG="${ROUTINE_WORK:-$STATE}/metro.log"
SKILL_DIR="$(cd "$(dirname "$0")" && pwd)"

fail() { echo "preflight: FATAL $*"; exit 1; }

# 0. Last night's Metro, if its digest never ran. By recorded PID only.
"$SKILL_DIR/scripts/metro-stop.sh"

# 1. Simulator and app.
if ! xcrun simctl list devices booted | grep -q "$UDID"; then
  xcrun simctl boot "$UDID" 2>/dev/null
  xcrun simctl bootstatus "$UDID" -b >/dev/null 2>&1 || fail "simulator $UDID did not boot"
fi
echo "preflight: simulator $UDID booted"
APP_PATH="$(xcrun simctl get_app_container "$UDID" "$BUNDLE_ID" 2>/dev/null)" \
  || fail "$BUNDLE_ID is not installed on $UDID"
NATIVE="$(/usr/libexec/PlistBuddy -c 'Print :CFBundleShortVersionString' "$APP_PATH/Info.plist")($(/usr/libexec/PlistBuddy -c 'Print :CFBundleVersion' "$APP_PATH/Info.plist"))"
echo "preflight: native build $NATIVE"

# 2. The scout's checkout, at origin/main. Detached on purpose: nobody works here.
[[ -d "$APP_DIR/.git" ]] || fail "scout checkout missing at $APP_DIR"
cd "$APP_DIR" || fail "cannot enter $APP_DIR"
OLD_LOCK="$(git rev-parse -q HEAD:pnpm-lock.yaml 2>/dev/null)"
GIT_TERMINAL_PROMPT=0 git fetch -q origin || fail "git fetch origin failed"
git checkout -q --detach -f origin/main || fail "checkout origin/main failed"
JS="$(git rev-parse --short HEAD)"
echo "preflight: JS source $JS ($(git log -1 --format=%cd --date=short))"
if [[ "$(git rev-parse -q HEAD:pnpm-lock.yaml)" != "$OLD_LOCK" || ! -d node_modules ]]; then
  echo "preflight: lockfile changed — installing"
  npm_config_userconfig="$NPMRC" pnpm install --frozen-lockfile >> "$METRO_LOG" 2>&1 \
    || fail "pnpm install failed (see $METRO_LOG)"
fi

# 3. Metro, in its own process group so metro-stop.sh can reap all of it.
: > "$METRO_LOG.bundle"
set -m
CI=1 nohup pnpm exec expo start --dev-client --port "$PORT" > "$METRO_LOG.bundle" 2>&1 &
echo $! > "$PIDFILE"
set +m
for _ in $(seq 1 60); do
  curl -fsS -m 2 "http://localhost:$PORT/status" 2>/dev/null | grep -q running && break
  sleep 2
done
curl -fsS -m 2 "http://localhost:$PORT/status" 2>/dev/null | grep -q running || fail "Metro never came up on :$PORT"
echo "preflight: Metro pid $(cat "$PIDFILE") on :$PORT"

xcrun simctl terminate "$UDID" "$BUNDLE_ID" 2>/dev/null
xcrun simctl openurl "$UDID" "exp+openfloor://expo-development-client/?url=http%3A%2F%2Flocalhost%3A$PORT" \
  || fail "could not open the dev client at :$PORT"
for _ in $(seq 1 60); do grep -q "Bundled" "$METRO_LOG.bundle" && break; sleep 2; done
grep -q "Bundled" "$METRO_LOG.bundle" || fail "the dev client never bundled from :$PORT — it may be pointed at another Metro"
echo "preflight: $(grep -m1 Bundled "$METRO_LOG.bundle" | sed 's/^[[:space:]]*//')"
sleep 8

# 4. The driver. A night with no driver would read as a night with no findings.
maestro --device "$UDID" hierarchy > "${ROUTINE_WORK:-$STATE}/preflight-hierarchy.json" 2>/dev/null \
  || fail "maestro could not read the UI tree"
grep -q '"OpenFloor"' "${ROUTINE_WORK:-$STATE}/preflight-hierarchy.json" \
  || fail "maestro read a tree without OpenFloor in it"
echo "preflight: maestro reads the app"

if [[ -n "${ROUTINE_WORK:-}" ]]; then
  printf 'udid=%s\njs=%s\nnative=%s\nmetro=http://localhost:%s\n' "$UDID" "$JS" "$NATIVE" "$PORT" \
    > "$ROUTINE_WORK/build-stamp.txt"
fi
exit 0
